{
  "name": "@cossistant/next",
  "type": "module",
  "version": "0.2.0",
  "private": false,
  "author": "Cossistant team",
  "description": "Next.js-ready SDK for building AI-powered support/chat widgets. Hooks + primitives, WS-driven, TypeScript-first. Next.js-ready, Tailwind optional.",
  "keywords": [
    "nextjs",
    "react",
    "headless-ui",
    "support-widget",
    "chat-widget",
    "customer-support",
    "helpdesk",
    "live-chat",
    "ai-support",
    "websocket",
    "typescript",
    "tailwind",
    "accessibility"
  ],
  "bugs": {
    "url": "https://github.com/cossistantcom/cossistant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cossistantcom/cossistant.git",
    "directory": "packages/next"
  },
  "license": "MIT",
  "homepage": "https://cossistant.com",
  "exports": {
    ".": "./src/index.ts",
    "./feedback": "./src/feedback/index.tsx",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/button": "./src/primitives/button.tsx",
    "./primitives/command-block-utils": "./src/primitives/command-block-utils.ts",
    "./primitives/conversation-timeline": "./src/primitives/conversation-timeline.tsx",
    "./primitives/day-separator": "./src/primitives/day-separator.tsx",
    "./primitives/feedback-comment-input": "./src/primitives/feedback-comment-input.tsx",
    "./primitives/feedback-rating-selector": "./src/primitives/feedback-rating-selector.tsx",
    "./primitives/feedback-topic-select": "./src/primitives/feedback-topic-select.tsx",
    "./primitives/multimodal-input": "./src/primitives/multimodal-input.tsx",
    "./primitives/router": "./src/primitives/router.tsx",
    "./primitives/timeline-code-block": "./src/primitives/timeline-code-block.tsx",
    "./primitives/timeline-command-block": "./src/primitives/timeline-command-block.tsx",
    "./primitives/timeline-item": "./src/primitives/timeline-item.tsx",
    "./primitives/timeline-item-attachments": "./src/primitives/timeline-item-attachments.tsx",
    "./primitives/timeline-item-group": "./src/primitives/timeline-item-group.tsx",
    "./primitives/timeline-message-layout": "./src/primitives/timeline-message-layout.ts",
    "./primitives/timeline-read-receipts": "./src/primitives/timeline-read-receipts.tsx",
    "./primitives/tool-activity-row": "./src/primitives/tool-activity-row.tsx",
    "./primitives/trigger": "./src/primitives/trigger.tsx",
    "./primitives/window": "./src/primitives/window.tsx",
    "./support": "./src/support/index.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/use-create-conversation": "./src/hooks/use-create-conversation.ts",
    "./hooks/use-feedback-form": "./src/hooks/use-feedback-form.ts",
    "./hooks/use-file-upload": "./src/hooks/use-file-upload.ts",
    "./hooks/use-send-message": "./src/hooks/use-send-message.ts",
    "./hooks/use-submit-feedback": "./src/hooks/use-submit-feedback.ts",
    "./internal/hooks": "./src/internal/hooks.ts",
    "./support.css": "./src/support.css",
    "./styles.css": "./src/styles.css",
    "./realtime": "./src/realtime/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/conversation": "./src/utils/conversation.ts",
    "./utils/id": "./src/utils/id.ts",
    "./utils/merge-refs": "./src/utils/merge-refs.ts",
    "./utils/use-render-element": "./src/utils/use-render-element.tsx",
    "./identify-visitor": "./src/identify-visitor.tsx",
    "./provider": "./src/provider.tsx",
    "./support-config": "./src/support-config.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@cossistant/react": "workspace:*"
  },
  "devDependencies": {
    "@cossistant/typescript-config": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "next": ">=13.5.2 || ^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "build": "tsdown && bun run rewrite:types && rm -rf dist/node_modules dist/packages && find dist -name '*.map' -delete && bun run build:css && bun run prepare-package",
    "build:css": "mkdir -p dist && cp src/support.css dist/support.css && cp src/styles.css dist/styles.css",
    "rewrite:types": "bun scripts/rewrite-dist-types.ts",
    "pub:release": "bun run build && npm publish ./dist --access public",
    "pub:beta": "bun run build && npm publish ./dist --access public --tag beta --no-git-checks",
    "pub:next": "bun run build && npm publish ./dist --access public --tag next --no-git-checks",
    "prepare-package": "bun ../../scripts/prepare-package.ts",
    "test": "bun test src",
    "lint": "biome check .",
    "check-types": "tsc --noEmit --project tsconfig.json"
  }
}
