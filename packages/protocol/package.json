{
  "name": "@cossistant/protocol",
  "type": "module",
  "version": "0.3.0",
  "private": false,
  "author": "Cossistant Team",
  "description": "Canonical HTTP and WebSocket wire contract for the Cossistant API",
  "keywords": [
    "openapi",
    "protocol",
    "contract",
    "hono",
    "api"
  ],
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes/index.ts",
    "./openapi": "./src/openapi.ts",
    "./testkit": "./src/testkit.ts",
    "./openapi.json": "./openapi.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "devDependencies": {
    "@cossistant/typescript-config": "workspace:*",
    "hono": "^4.12.32",
    "@types/bun": "^1.3.6"
  },
  "dependencies": {
    "@cossistant/types": "workspace:*",
    "@hono/zod-openapi": "^1.5.1",
    "openapi3-ts": "^4.5.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "hono": ">=4.10.0"
  },
  "scripts": {
    "build": "tsdown && bun run generate:openapi && bun run prepare-package",
    "generate:openapi": "bun run scripts/generate-openapi.ts",
    "check:openapi": "bun run scripts/generate-openapi.ts --check",
    "prepare-package": "bun ../../scripts/prepare-package.ts",
    "pub:release": "bun run build && npm publish ./dist --access public",
    "pub:beta": "bun run build && npm publish ./dist --access public --tag beta --no-git-checks",
    "pub:next": "bun run build && npm publish ./dist --access public --tag next --no-git-checks",
    "lint": "biome check .",
    "test": "bun test src",
    "check-types": "tsc --noEmit --project tsconfig.json"
  }
}
